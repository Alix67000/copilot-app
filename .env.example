# ID d'application (client) d'une application Microsoft Entra enregistrée en SPA
VITE_MICROSOFT_CLIENT_ID=
# ID du locataire professionnel ou « organizations »
VITE_MICROSOFT_TENANT_ID=organizations
# Identifiant client OAuth Google de type application Web (public, pas de secret)
VITE_GOOGLE_CLIENT_ID=
# Variables SERVEUR uniquement. Ne jamais ajouter le préfixe VITE_ à la clé.
GEMINI_API_KEY=
ALLOWED_GOOGLE_EMAIL=
GEMINI_MODEL=gemini-2.5-flash
